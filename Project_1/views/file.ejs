<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= filename %></title>
    <style>
        body {
            background-color: #1a202c;
            color: white;
            font-family: Arial, sans-serif;
            margin: 24px;
        }
        #new-title {
            background-color: #2d3748;
            border: solid 5px #4a5568;
            color: white;
            font-size: 16px;
            padding: 8px;
        }
        textarea {
            box-sizing: border-box;
            background-color: #2d3748;
            border: none;
            color: white;
            font-size: 16px;
            min-height: 60vh;
            padding: 10px;
            width: 100%;
        }
        textarea,#new-title:focus {
            outline: none;
            border: 2px solid #4a5568;
        }
        button {
            margin-top: 12px;
            display: inline-block;
            margin-bottom: 12px;
            background-color: #4a5568;
            color: white;
            border: none;
            padding: 8px 16px;
            text-decoration: none;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <h1><%= filename %></h1>
    <form method="POST" action="/files/<%= encodeURIComponent(filename) %>/rename">
        <input type="hidden" name="returnTo" value="detail" >
        <label for="new-title">Rename file</label>
        <input id="new-title" type="text" name="newTitle" value="<%= filename.slice(0, -4) %>" style="height: 30px; width:100px;background-color: #1a202c; border: none; color: white;" required>
        <button type="submit">Rename</button>
    </form>
    <button onclick="window.location.href = '/';">Back to tasks</button>

    <% if (saved) { %>
        <p role="status">Saved successfully.</p>
    <% } %>
    <form method="POST" action="/files/<%= encodeURIComponent(filename) %>">
        <textarea name="content" aria-label="File content"><%= content %></textarea>
        <br>
        <button type="submit">Save changes</button>
    </form>
</body>
</html>
