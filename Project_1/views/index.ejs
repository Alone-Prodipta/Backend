<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tasks</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
    <link rel="stylesheet" href="css/style.css">
</head>

<body class="task-page">
    <main class="container-fluid p-4">
        <form class="task-form" aria-label="Create a task" method="POST" action="/create">
            <input type="text" class="form-control mb-1" placeholder="Title goes here..." aria-label="Task title" name="title">
            <br>
            <textarea class="form-control mb-1" rows="2" placeholder="Write your task details here..."
                aria-label="Task details" name="details"></textarea>
            <button type="submit" class="btn btn-primary btn-sm">Create Task</button>
        </form>

        <div class="tasks flex gap-5 flex-wrap p-10">
            <% if (files && files.length > 0) { %>
                <% files.forEach(function (val) { %>
                    <div class="task w-72 px-3 py-4 rounded-md bg-zinc-800">
                        <h1 class="text-white text-3xl tracking-tighter"><%= val %></h1>
                        <a class="text-blue-500 inline-block mt-3" href="/files/<%= encodeURIComponent(val) %>">Read more</a>
                        <form method="POST" action="/files/<%= encodeURIComponent(val) %>/delete"
                            onsubmit="return confirm('Delete this task? This cannot be undone.');">
                            <button class="btn btn-danger btn-sm mt-3" type="submit">Delete</button>
                        </form>
                    </div>
                <% }); %>
            <% } else { %>
                <h3 class="text-white text-3xl tracking-tighter">No tasks found</h3>
            <% } %>
        </div>
    </main>
    <script src="javascript/script.js"></script>
    <script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL"
        crossorigin="anonymous"></script>
</body>

</html>