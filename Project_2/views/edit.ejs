<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body class="m-0 min-h-screen bg-[#050d14] text-white antialiased">
    <h1 class="text-center text-3xl font-bold tracking-tight text-white sm:text-4xl">
      Update User
    </h1>
    <main class="flex min-h-screen items-center justify-center px-4">
      <form action="/edit/<%= updatedUser._id %>" method="POST" class="flex w-full max-w-6xl items-center gap-3">
        <input
          type="text"
          name="username"
          placeholder="name"
          required
          class="h-11 flex-1 rounded-xl border border-white/10 bg-white/3 px-4 text-sm text-white placeholder:text-white/35 shadow-[inset_0_1px_0_rgba(255,255,255,0.04)] outline-none transition focus:border-sky-400/70 focus:ring-2 focus:ring-sky-500/20" value="<%= updatedUser.username %>"
        />
        <input
          type="email"
          name="email"
          placeholder="email"
          required
          class="h-11 flex-1 rounded-xl border border-white/10 bg-white/3 px-4 text-sm text-white placeholder:text-white/35 shadow-[inset_0_1px_0_rgba(255,255,255,0.04)] outline-none transition focus:border-sky-400/70 focus:ring-2 focus:ring-sky-500/20" value="<%= updatedUser.email %>"
        />
        <input
          type="text"
          name="image_url"
          placeholder="image url"
          class="h-11 flex-1 rounded-xl border border-white/10 bg-white/3 px-4 text-sm text-white placeholder:text-white/35 shadow-[inset_0_1px_0_rgba(255,255,255,0.04)] outline-none transition focus:border-sky-400/70 focus:ring-2 focus:ring-sky-500/20" value="<%= updatedUser.image_url %>"
        />
        <button
          type="submit"
          class="inline-flex h-11 min-w-[128px] items-center justify-center rounded-xl bg-gradient-to-b from-sky-400 to-sky-500 px-5 text-sm font-semibold text-white shadow-[0_10px_22px_rgba(32,144,255,0.45)] transition hover:brightness-110 focus:outline-none focus:ring-2 focus:ring-sky-300/60"
        >
          Update User
        </button>
      </form>
    </main>
  </body>
</html>
