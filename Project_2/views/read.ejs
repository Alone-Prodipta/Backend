<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Read User</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body class="m-0 min-h-screen bg-[#020b12] text-white">
    <main class="flex flex-wrap items-start gap-6 p-6">
      <% users.forEach((user) => { %>
        <div class="w-72 rounded-lg bg-zinc-800 p-4 shadow-xl shadow-black/30">
          <% if (user.image_url) { %>
            <img src="<%= user.image_url %>" alt="<%= user.username %>" class="h-52 w-full rounded-lg object-cover" />
          <% } else { %>
            <div class="h-52 w-full rounded-lg bg-zinc-700"></div>
          <% } %>
          <h3 class="mt-3 text-xl tracking-tighter text-white"><%= user.username %></h3>
          <h5 class="text-zinc-500"><%= user.email %></h5>
          <div class="mt-10 flex gap-3">
            <a href="/edit/<%= user._id %>" class="text-zinc-200 transition hover:text-white">Edit User</a>
            <a href="/delete/<%= user._id %>" class="text-red-500 transition hover:text-red-400">Delete</a>
          </div>
        </div>
      <% }); %>
    </main>
  </body>
</html>
